#!/usr/bin/env python3
"""
Kanaha Camera Discovery - Zero-config camera discovery via mDNS
Usage: kanaha-discover [--json]
"""
import socket
import struct
import sys
import json as json_lib

def discover_cameras(timeout=3):
    """Discover Kanaha cameras via mDNS"""
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 255)
    
    mreq = struct.pack('4sl', socket.inet_aton('224.0.0.251'), socket.INADDR_ANY)
    sock.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, mreq)
    sock.bind(('', 5353))
    sock.settimeout(timeout)
    
    # Query for _https._tcp.local PTR
    query = b'\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00'
    query += b'\x06_https\x04_tcp\x05local\x00\x00\x0c\x00\x01'
    sock.sendto(query, ('224.0.0.251', 5353))
    
    cameras = {}
    
    try:
        while True:
            data, addr = sock.recvfrom(4096)
            
            # Only process Kanaha cameras
            if b'kanaha-camera-control' not in data:
                continue
            
            camera = {'source_ip': addr[0], 'port': 8443}
            
            # Extract all TXT record key=value pairs
            # TXT records are formatted as: length-byte + "key=value"
            i = 0
            while i < len(data):
                # Find TXT record (type 0x0010)
                if i + 10 < len(data) and data[i:i+2] == b'\x00\x10':
                    # Skip to RDLENGTH (after type + class + TTL = 8 bytes)
                    rdlen_pos = i + 8
                    if rdlen_pos + 2 > len(data):
                        i += 1
                        continue
                    rdlen = struct.unpack('!H', data[rdlen_pos:rdlen_pos+2])[0]
                    txt_start = rdlen_pos + 2
                    txt_end = txt_start + rdlen
                    
                    # Parse TXT strings
                    pos = txt_start
                    while pos < txt_end and pos < len(data):
                        slen = data[pos]
                        pos += 1
                        if pos + slen <= len(data):
                            txt = data[pos:pos+slen].decode('utf-8', errors='replace')
                            if '=' in txt:
                                k, v = txt.split('=', 1)
                                camera[k] = v
                        pos += slen
                i += 1
            
            # Extract SRV record for port and hostname
            i = 0
            while i < len(data):
                if i + 10 < len(data) and data[i:i+2] == b'\x00\x21':  # SRV type
                    rdlen_pos = i + 8
                    if rdlen_pos + 8 > len(data):
                        i += 1
                        continue
                    rdlen = struct.unpack('!H', data[rdlen_pos:rdlen_pos+2])[0]
                    srv_start = rdlen_pos + 2
                    if srv_start + 6 <= len(data):
                        _, _, port = struct.unpack('!HHH', data[srv_start:srv_start+6])
                        camera['port'] = port
                        
                        # Parse target hostname
                        labels = []
                        pos = srv_start + 6
                        while pos < len(data):
                            length = data[pos]
                            if length == 0:
                                break
                            if (length & 0xC0) == 0xC0:  # Compression
                                ptr = struct.unpack('!H', data[pos:pos+2])[0] & 0x3FFF
                                # Follow pointer (simplified)
                                while ptr < len(data) and data[ptr] != 0 and (data[ptr] & 0xC0) != 0xC0:
                                    plen = data[ptr]
                                    labels.append(data[ptr+1:ptr+1+plen].decode('utf-8', errors='replace'))
                                    ptr += plen + 1
                                break
                            else:
                                pos += 1
                                labels.append(data[pos:pos+length].decode('utf-8', errors='replace'))
                                pos += length
                        # Build hostname - don't add .local if already present
                        if labels:
                            hostname = '.'.join(labels)
                            if not hostname.endswith('.local'):
                                hostname += '.local'
                            camera['hostname'] = hostname
                        else:
                            camera['hostname'] = None
                    break
                i += 1
            
            # Use IP from TXT record if available
            if 'ip' in camera:
                camera['ip'] = camera['ip']
            else:
                camera['ip'] = camera['source_ip']
            
            cameras[camera['ip']] = camera
            
    except socket.timeout:
        pass
    
    sock.close()
    return cameras

def main():
    json_output = '--json' in sys.argv
    
    cameras = discover_cameras(timeout=3)
    
    if json_output:
        output = []
        for ip, cam in cameras.items():
            hostname = cam.get('hostname')
            port = cam.get('port', 8443)
            url_host = hostname if hostname else cam.get('ip', ip)
            output.append({
                'name': cam.get('name', 'unknown'),
                'ip': cam.get('ip', ip),
                'hostname': hostname,
                'port': port,
                'model': cam.get('model', 'Unknown'),
                'manufacturer': cam.get('manufacturer', 'Unknown'),
                'api': cam.get('api'),
                'version': cam.get('version'),
                'url': f"https://{url_host}:{port}/services/CameraControlService",
            })
        print(json_lib.dumps(output, indent=2))
        return
    
    if not cameras:
        print("No Kanaha cameras found on network.")
        print("\nTroubleshooting:")
        print("  - Ensure Kanaha camera app is running")
        print("  - Ensure both devices are on the same WiFi network")
        sys.exit(1)
    
    print(f"Found {len(cameras)} Kanaha camera(s):\n")
    
    for ip, cam in cameras.items():
        name = cam.get('name', 'unknown')
        model = cam.get('model', 'Unknown Model')
        mfr = cam.get('manufacturer', '')
        hostname = cam.get('hostname')
        port = cam.get('port', 8443)
        version = cam.get('version', '')
        url_host = hostname if hostname else ip

        print(f"  {name} ({mfr} {model})")
        print(f"    IP:       {ip}")
        if hostname:
            print(f"    Hostname: {hostname}")
        print(f"    Port:     {port}")
        print(f"    Version:  {version}")
        print(f"    URL:      https://{url_host}:{port}/services/CameraControlService")
        print()

if __name__ == '__main__':
    main()
